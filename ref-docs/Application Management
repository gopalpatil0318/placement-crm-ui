      {
        "application_id": "i9j0k1l2-...",
        "student_name": "Priya Patel",
        "current_status": "rejected",
        "reason": "Cannot transition from \"rejected\" to \"shortlisted\""
      }
    ],
    "errors": []
  }
}
```

