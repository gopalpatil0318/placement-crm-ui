# ============================================================================
# PLACEMENT CRM UI — Environment Variables
# ============================================================================
# Copy this file as .env and fill in your values.
# ============================================================================

# --- Vite Dev Server Proxy Target ---
# Only used in local development (Vite proxy). Not needed in production.
PCRM_BACKEND_URL=http://localhost:4000

# --- API Base URL ---
# Local dev: /api  (Vite proxy handles forwarding to backend)
# Production: https://api.placenex.in/api  (set in Vercel env vars)
VITE_API_BASE_URL=/api
