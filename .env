# ============================================================================
# PLACEMENT CRM UI — Local Development
# ============================================================================
# This file is for LOCAL development only. Do NOT commit secrets here.
# For production, set env vars in Vercel Dashboard → Settings → Environment Variables.
# ============================================================================

# --- Vite Dev Server Proxy Target ---
# Points to the local backend API server
# PCRM_BACKEND_URL=https://testpcrmapi.vercel.app
PCRM_BACKEND_URL=http://localhost:4000/
# --- API Base URL (used by Axios in src/lib/api.ts) ---
# In dev, Vite proxies /api → PCRM_BACKEND_URL
# In production (Vercel), set VITE_API_BASE_URL to the full backend URL
VITE_API_BASE_URL=/api